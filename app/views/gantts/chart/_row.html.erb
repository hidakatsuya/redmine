<div class="gantt__row gantt__row--<%= row.kind %>"
     id="gantt-row-<%= row.row_key %>"
     data-gantt--chart-target="row"
     data-gantt--subjects-target="row"
     data-row-key="<%= row.row_key %>"
     data-parent-row-key="<%= row.parent_row_key %>"
     data-kind="<%= row.kind %>"
     data-progress-state="<%= gantt_progress_state(row) %>"
     style="<%= gantt_row_style(row) %>">
  <div class="gantt__row-information">
    <div class="gantt__sidebar-grid">
      <div class="gantt__subject-cell">
        <%= gantt_row_subject_tag(row) do %>
          <% if row.expandable? %>
            <%= tag.button sprite_icon('angle-down', rtl: true),
                           type: 'button',
                           class: ['gantt__expander', 'icon', 'icon-expanded'],
                           aria: {expanded: true},
                           data: {action: 'click->gantt--subjects#toggleRow'} %>
          <% else %>
            <%= tag.span '', class: 'gantt__expander-placeholder', aria: {hidden: true} %>
          <% end %>

          <%= tag.span class: gantt_row_subject_text_classes(row), title: row.subject do %>
            <%= render partial: "gantts/chart/rows/#{row.kind}", locals: {row: row} %>
          <% end %>
        <% end %>
      </div>

      <% chart.selected_columns.each do |column| %>
        <div class="gantt__column-cell">
          <% if row.issue? %>
            <%= tag.div column_content(column, row.issue), class: ['gantt__cell-value', column.css_classes] %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="gantt__timeline-cell">
    <%= render partial: 'gantts/chart/schedule', locals: {row: row} %>
  </div>
</div>
