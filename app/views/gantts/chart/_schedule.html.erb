<%# Timeline portion shared by all row types: bar layers, endpoint diamonds, label and issue hit area. %>
<% if row.schedule&.visible? %>
  <%= gantt_schedule_bar_tag(row) %>
  <%= gantt_schedule_late_bar_tag(row) %>
  <%= gantt_schedule_done_bar_tag(row, day_width: chart.day_width) %>

  <%= gantt_schedule_marker_tag(row, :start) %>
  <%= gantt_schedule_marker_tag(row, :end) %>

  <% if row.context_menu? %>
    <div class="tooltip hascontextmenu gantt__bar-hitbox"
         style="<%= gantt_schedule_bar_style(row.schedule) %>"
         data-row-key="<%= row.row_key %>">
      <span class="tip"><%= render_issue_tooltip(row.issue) %></span>
      <%= tag.input type: 'checkbox', name: 'ids[]', value: row.issue.id,
                    style: 'display:none;', class: 'toggle-selection' %>
    </div>
  <% end %>
<% end %>

<% if row.schedule %>
  <div class="gantt__label"><%= gantt_schedule_label_tag(row.schedule) %></div>
<% end %>
