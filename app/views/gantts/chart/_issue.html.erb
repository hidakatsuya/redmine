<%= gantt_row_tag(row) do %>
  <div class="gantt__row-information gantt__sidebar-grid">
    <div class="gantt__subject-cell">
      <%= gantt_row_subject_tag(row) do %>
        <%= gantt_row_expander_tag(row) %>

        <%= gantt_issue_subject_tag(row) do %>
          <%= sprite_icon('issue') unless row.issue.assigned_to -%>
          <%= assignee_avatar(row.issue.assigned_to, size: 13, class: 'icon-avatar') -%>
          <%= link_to_issue(row.issue) -%>
          <%= tag.input type: 'checkbox', name: 'ids[]', value: row.issue.id,
                        style: 'display:none;', class: 'toggle-selection' %>
        <% end %>
      <% end %>
    </div>

    <% chart.selected_columns.each do |column| %>
      <div class="gantt__column-cell">
        <%= gantt_column_value_tag(column, row.issue) %>
      </div>
    <% end %>
  </div>

  <div class="gantt__timeline-cell">
    <%= render partial: 'gantts/chart/schedule', locals: {row: row, chart: chart} %>
  </div>
<% end %>
