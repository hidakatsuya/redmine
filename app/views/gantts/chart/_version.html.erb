<%= gantt_row_tag(row) do %>
  <div class="gantt__row-information gantt__sidebar-grid">
    <div class="gantt__subject-cell">
      <%= gantt_row_subject_tag(row) do %>
        <%= render partial: 'gantts/chart/expander', locals: {row: row} %>

        <%= tag.span class: [
              'gantt__subject-text',
              {
                'version-behind-schedule': row.behind_schedule?,
                'version-overdue': row.overdue?,
                'version-closed': row.closed?,
                'behind-start-date': row.behind_start_date?,
                'over-end-date': row.over_end_date?
              }
            ],
            title: row.subject do %>
          <%= sprite_icon('package') -%>
          <%= link_to_version(row.version) %>
        <% end %>
      <% end %>
    </div>

    <% chart.selected_columns.each do %>
      <div class="gantt__column-cell"></div>
    <% end %>
  </div>

  <div class="gantt__timeline-cell">
    <%= render partial: 'gantts/chart/schedule', locals: {row: row} %>
  </div>
<% end %>
