<div class="gantt__row gantt__row--<%= row.kind %>"
     id="gantt-row-<%= row.row_key %>"
     data-gantt--chart-target="row"
     data-gantt--subjects-target="row"
     data-row-key="<%= row.row_key %>"
     data-parent-row-key="<%= row.parent_row_key %>"
     data-kind="<%= row.kind %>"
     data-progress-state="<%= gantt_progress_state(row) %>"
     style="<%= gantt_row_style(row) %>">
  <div class="gantt__row-information">
    <%= render partial: gantt_row_partial(row), locals: {row: row, chart: chart} %>
  </div>

  <div class="gantt__timeline-cell">
    <%= render partial: 'gantts/rows/schedule', locals: {row: row} %>
  </div>
</div>
