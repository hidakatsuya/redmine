<%
  layout = GanttHelper::ChartLayout.new(gantt)
  gantt.render(
    top: layout.content_top,
    zoom: layout.zoom,
    g_width: layout.chart_width,
    subject_width: layout.subject_width
  )
%>

<% if gantt.truncated %>
  <p class="warning"><%= l(:notice_gantt_chart_truncated, max: gantt.max_rows) %></p>
<% end %>

<%
  columns = query.columns.reject {|column| Redmine::Helpers::Gantt::UNAVAILABLE_COLUMNS.include?(column.name)}
%>
<%= gantt_chart_tag(@query, layout) do %>
  <div class="gantt-chart-header" data-gantt--sticky-header-target="header">
    <div class="gantt-chart-header-content" data-gantt--scroll-target="header"
         data-action="scroll->gantt--scroll#syncColumns:passive">
      <%= gantt_subject_column_tag(header: true) do %>
        <section class="gantt-pane">
          <header aria-hidden="true"></header>
        </section>
        <%= gantt_column_resize_handle_tag %>
      <% end %>

      <% columns.each do |column| %>
        <%= gantt_column_tag(column.name.to_s.tr('.', '_'), header: true, min_width: 20, width: '50px',
                             class: 'gantt-selected-column', hidden: !query.draw_selected_columns,
                             data: {'gantt--chart-target': 'selectedColumn'}) do %>
          <section class="gantt-pane">
            <header><%= column.caption %></header>
          </section>
          <%= gantt_column_resize_handle_tag %>
        <% end %>
      <% end %>

      <div class="gantt-timeline-header-scroll" data-gantt--scroll-target="timelineHeader"
           data-action="scroll->gantt--scroll#syncTimeline:passive">
        <%= render partial: 'gantts/timeline_header', locals: {layout: layout, gantt: gantt} %>
      </div>
    </div>
  </div>

  <div class="gantt-chart-body" data-gantt--scroll-target="body"
       data-action="scroll->gantt--scroll#syncColumns:passive">
    <%= gantt_subject_column_tag do %>
      <section class="gantt-pane">
        <div class="gantt-pane-body" data-controller="gantt--subjects">
          <%= form_tag({}, data: {cm_url: issues_context_menu_path}) do %>
            <%= hidden_field_tag 'back_url', url_for(params: request.query_parameters), id: nil %>
            <%= gantt.subjects.html_safe %>
          <% end %>
        </div>
      </section>
      <%= gantt_column_resize_handle_tag %>
    <% end %>

    <% columns.each do |column| %>
      <%= gantt_column_tag(column.name.to_s.tr('.', '_'), min_width: 20, width: '50px',
                           class: 'gantt-selected-column', hidden: !query.draw_selected_columns,
                           data: {'gantt--chart-target': 'selectedColumn'}) do %>
        <section class="gantt-pane">
          <div class="gantt-pane-body">
            <%= gantt.selected_column_content(column: column, top: layout.content_top, zoom: layout.zoom, g_width: layout.chart_width).html_safe %>
          </div>
        </section>
        <%= gantt_column_resize_handle_tag %>
      <% end %>
    <% end %>

    <div class="gantt-timeline" data-gantt--scroll-target="timeline"
         data-action="scroll->gantt--scroll#syncTimeline:passive">
      <div class="gantt-timeline-canvas">
        <div class="gantt-timeline-grid" aria-hidden="true">
          <% (layout.months + layout.weeks + layout.days).select(&:spans_body).each do |period| %>
            <div class="gantt-period<%= ' gantt-period-non-working' if period.non_working %><%= ' gantt-period-last' if period.last %>"
                 style="<%= gantt_period_style(period) %>"></div>
          <% end %>
        </div>
        <div class="gantt-timeline-body">
          <%= form_tag({}, data: {cm_url: issues_context_menu_path}) do %>
            <%= hidden_field_tag 'back_url', url_for(params: request.query_parameters), id: nil %>
            <%= gantt.lines.html_safe %>
          <% end %>

          <% if layout.today_start %>
            <div class="gantt-today" data-gantt--chart-target="today" style="<%= gantt_css_variables('gantt-today-start': "#{layout.today_start}px") %>" aria-hidden="true"></div>
          <% end %>

          <div class="gantt-relations" data-gantt--chart-target="relations" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </div>
<% end %>

<span class="pagination">
  <ul class="pages">
    <li class="previous page">
      <%= link_to("\xc2\xab " + l(:label_previous),
                  {params: request.query_parameters.merge(gantt.params_previous)},
                  accesskey: accesskey(:previous)) %>
    </li><li class="next page">
      <%= link_to(l(:label_next) + " \xc2\xbb",
                  {params: request.query_parameters.merge(gantt.params_next)},
                  accesskey: accesskey(:next)) %>
    </li>
  </ul>
</span>

<% if @export_allowed %>
<% other_formats_links do |f| %>
  <%= f.link_to_with_query_parameters 'PDF', gantt.params %>
  <%= f.link_to_with_query_parameters('PNG', gantt.params) if gantt.respond_to?('to_image') %>
<% end %>
<% end %>
