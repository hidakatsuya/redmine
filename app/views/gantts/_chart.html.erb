<% chart = gantt.chart %>
<% scale_segments = chart.scale_segments.group_by(&:layer) %>

<% if gantt.truncated %>
  <p class="warning"><%= l(:notice_gantt_chart_truncated, max: gantt.max_rows) %></p>
<% end %>

<%= gantt_chart_tag(query, chart, project: @project) do %>
  <div class="gantt__viewport" data-gantt--chart-target="viewport">
    <%= form_tag({}, data: {cm_url: issues_context_menu_path}, class: 'gantt__layout') do %>
      <%= hidden_field_tag 'back_url', url_for(params: request.query_parameters), id: nil %>

      <section class="gantt__sidebar" data-controller="gantt--subjects" data-gantt--chart-target="sidebar">
        <div class="gantt__header gantt__header--sidebar">
          <div class="gantt__sidebar-grid gantt__sidebar-grid--header" style="<%= gantt_sidebar_grid_style(chart) %>">
            <div class="gantt__subject-header"><%= l(:field_subject) %></div>
            <% chart.available_columns.each do |column| %>
              <div class="gantt__column-header" data-column-name="<%= column.name %>">
                <%= column.caption %>
              </div>
            <% end %>
          </div>
          <div class="gantt__splitter"
               data-controller="gantt--splitter"
               data-action="pointerdown->gantt--splitter#startResize"></div>
        </div>

        <div class="gantt__rows gantt__rows--sidebar">
          <% chart.rows.each do |row| %>
            <%= render partial: 'gantts/sidebar_row', locals: {row: row, chart: chart} %>
          <% end %>
        </div>
      </section>

      <section class="gantt__timeline">
        <div class="gantt__header gantt__header--timeline">
          <div class="gantt__scale" data-gantt--chart-target="timelineHeader">
            <% scale_segments.each do |layer, segments| %>
              <div class="gantt__scale-row gantt__scale-row--<%= layer %>">
                <% segments.each do |segment| %>
                  <% segment_start = chart.date_from + segment.start_offset %>
                  <div class="<%= segment.css_classes.join(' ') %>"
                       style="<%= gantt_scale_segment_style(segment) %>"
                       title="<%= segment.title %>">
                    <% if layer.zero? %>
                      <%= link_to segment.label,
                                  gantt.params.merge(year: segment_start.year, month: segment_start.month),
                                  title: segment.title %>
                    <% else %>
                      <span><%= segment.label %></span>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="gantt__rows gantt__rows--timeline" id="gantt_area" data-gantt--chart-target="timelineRows">
          <% if chart.today_offset %>
            <div class="gantt__today-line"
                 id="today_line"
                 data-gantt--chart-target="todayLine"
                 style="--gantt-today-unit: <%= chart.today_offset %>"></div>
          <% end %>

          <% chart.rows.each do |row| %>
            <%= render partial: 'gantts/timeline_row', locals: {row: row, chart: chart} %>
          <% end %>

          <div class="gantt__overlay" id="gantt_draw_area" data-gantt--chart-target="overlay"></div>
        </div>
      </section>
    <% end %>
  </div>
<% end %>

<span class="pagination">
  <ul class="pages">
    <li class="previous page">
      <%= link_to("\xc2\xab " + l(:label_previous),
                  {params: request.query_parameters.merge(gantt.params_previous)},
                  accesskey: accesskey(:previous)) %>
    </li><li class="next page">
      <%= link_to(l(:label_next) + " \xc2\xbb",
                  {params: request.query_parameters.merge(gantt.params_next)},
                  accesskey: accesskey(:next)) %>
    </li>
  </ul>
</span>

<% other_formats_links do |f| %>
  <%= f.link_to_with_query_parameters 'PDF', gantt.params %>
  <%= f.link_to_with_query_parameters('PNG', gantt.params) if gantt.respond_to?('to_image') %>
<% end %>
